{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "stroomvoorspeller.online" }],
      "destination": "https://stroomvoorspeller.nl/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.stroomvoorspeller.online" }],
      "destination": "https://stroomvoorspeller.nl/:path*",
      "permanent": true
    },
    {
      "source": "/gids/wateraccu",
      "destination": "/kennisbank/wateraccu",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/data/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=900" }
      ]
    }
  ]
}
